{
  "name": "skoreon",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "applications/*",
    "libraries/domain/*",
    "libraries/foundation/*",
    "orchestrators/*",
    "services/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "dev": "alchemy dev",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/tsgo": "0.39.0",
    "@types/node": "24.13.3",
    "alchemy": "2.0.0-beta.75",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.112",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    }
  }
}
